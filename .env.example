# Live web provider selection. Feature 002 supports Exa first.
TRACERESEARCH_WEB_PROVIDER=exa

# Local-only secret. Keep real keys in your shell or ignored .env file.
EXA_API_KEY=

# Provider behavior for manual live smoke runs.
# Live smoke is manual only and is not part of the default pytest/CI gate.
TRACERESEARCH_WEB_TIMEOUT_SECONDS=10
TRACERESEARCH_WEB_MAX_RESULTS=5

# ---------------------------------------------------------------------------
# LLM-backed Writer / Verifier (Feature 003)
# ---------------------------------------------------------------------------
# LLM provider settings. Default: DeepSeek (OpenAI-compatible API).
# Set TRACERESEARCH_LLM_API_KEY or provider-specific key (e.g. DEEPSEEK_API_KEY).
TRACERESEARCH_LLM_PROVIDER=deepseek
TRACERESEARCH_LLM_API_KEY=
TRACERESEARCH_LLM_MODEL=deepseek-chat
TRACERESEARCH_LLM_BASE_URL=https://api.deepseek.com
TRACERESEARCH_LLM_TIMEOUT=60
TRACERESEARCH_LLM_MAX_TOKENS=4096
TRACERESEARCH_LLM_TEMPERATURE=0.0

# Writer/Verifier mode selection (deterministic | llm).
# Default: deterministic. LLM mode requires API key above.
TRACERESEARCH_WRITER_MODE=deterministic
TRACERESEARCH_VERIFIER_MODE=deterministic

# Provider-specific key fallback (used when TRACERESEARCH_LLM_API_KEY is unset)
DEEPSEEK_API_KEY=
